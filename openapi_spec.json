{
  "openapi": "3.1.0",
  "info": {
    "title": "Lab Turnaround Analyzer API",
    "description": "Laboratory TAT aggregation API with retained legacy agent routes",
    "version": "3.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus operational metrics",
        "responses": {
          "200": {
            "description": "JSON operational counters and status"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Dispatch task payload across specialized workers",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Air-gapped supervisory conversational assistant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/tat/analyze": {
      "post": {
        "summary": "Calculate timezone-aware TAT summary statistics",
        "description": "Accept CSV data and return aggregated metrics. Does not echo raw specimen-level rows.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "csv_text": {
                    "type": "string",
                    "description": "CSV with test, received_at, reported_at"
                  },
                  "threshold_minutes": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 60
                  }
                },
                "required": [
                  "csv_text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Overall and test-stratified descriptive statistics"
          },
          "422": {
            "description": "Invalid CSV schema, timestamps or threshold"
          }
        }
      }
    }
  }
}
