# Lab Turnaround Analyzer Environment Configuration
# Copy this file to .env and modify as needed

# HMAC-SHA256 Audit Trail Secret Key
# IMPORTANT: Set this to a strong random value in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=

# Legacy mock supervisor only (other provider names currently fall back to mock)
MODEL_PROVIDER=mock

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
